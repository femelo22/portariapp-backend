# Copie para .env (não versionado). Valores apenas para desenvolvimento local.
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# Porta do Postgres no host (mude se a 5432 estiver ocupada).
POSTGRES_PORT=5432
# Chave HMAC (>= 32 caracteres) usada para assinar os JWTs. Gere uma própria por ambiente.
JWT_SECRET=change-this-dev-only-secret-change-this-dev-only
